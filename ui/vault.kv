#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<AuthScreen>:
    name: "auth"
    MDBoxLayout:
        orientation: "vertical"
        padding: [dp(16 * app.ui_scale), dp(20 * app.ui_scale)]
        spacing: dp(14 * app.ui_scale)

        Widget:

        MDCard:
            orientation: "vertical"
            padding: dp(20 * app.ui_scale)
            spacing: dp(14 * app.ui_scale)
            size_hint_x: None
            width: min(root.width - dp(32 * app.ui_scale), dp(460))
            pos_hint: {"center_x": 0.5}
            size_hint_y: None
            height: self.minimum_height
            radius: [dp(16 * app.ui_scale)]
            elevation: 2

            MDLabel:
                text: "Создание хранилища" if root.is_setup_mode else "Вход в PassVault"
                font_style: "H5"
                font_size: sp(22 * app.ui_scale)
                halign: "center"
                adaptive_height: True

            MDLabel:
                text: "Задайте надёжный мастер-пароль. Восстановить его невозможно." if root.is_setup_mode else "Введите мастер-пароль для расшифровки базы."
                theme_text_color: "Secondary"
                font_style: "Caption"
                font_size: sp(12 * app.ui_scale)
                halign: "center"
                adaptive_height: True

            MDTextField:
                id: password_field
                hint_text: "Мастер-пароль"
                password: True
                mode: "rectangle"
                font_size: sp(15 * app.ui_scale)
                on_text_validate: root.submit_auth()

            MDTextField:
                id: confirm_field
                hint_text: "Повторите мастер-пароль"
                password: True
                mode: "rectangle"
                font_size: sp(15 * app.ui_scale)
                opacity: 1 if root.is_setup_mode else 0
                disabled: not root.is_setup_mode
                size_hint_y: None
                height: dp(56 * app.ui_scale) if root.is_setup_mode else 0
                on_text_validate: root.submit_auth()

            MDLabel:
                text: root.status_text
                theme_text_color: "Error"
                font_style: "Caption"
                font_size: sp(12 * app.ui_scale)
                halign: "center"
                adaptive_height: True

            MDRaisedButton:
                text: "Создать хранилище" if root.is_setup_mode else "Разблокировать"
                font_size: sp(15 * app.ui_scale)
                pos_hint: {"center_x": 0.5}
                size_hint_x: 1
                size_hint_y: None
                height: dp(46 * app.ui_scale)
                on_release: root.submit_auth()

        Widget:

<VaultScreen>:
    name: "vault"
    MDFloatLayout:
        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                title: "PassVault"
                right_action_items: [["lock", lambda x: root.lock_now()]]

            MDBoxLayout:
                orientation: "vertical"
                padding: [dp(12 * app.ui_scale), dp(10 * app.ui_scale), dp(12 * app.ui_scale), dp(76 * app.ui_scale)]
                spacing: dp(10 * app.ui_scale)

                MDTextField:
                    id: search_field
                    hint_text: "Поиск по названию, логину или категории"
                    mode: "rectangle"
                    font_size: sp(14 * app.ui_scale)
                    size_hint_y: None
                    height: dp(48 * app.ui_scale)
                    on_text: root.on_search_change(self.text)

                MDLabel:
                    text: root.empty_text
                    font_size: sp(14 * app.ui_scale)
                    halign: "center"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(36 * app.ui_scale) if root.entries_count == 0 else 0
                    opacity: 1 if root.entries_count == 0 else 0

                MDScrollView:
                    do_scroll_x: False
                    MDBoxLayout:
                        id: entries_list
                        orientation: "vertical"
                        spacing: dp(8 * app.ui_scale)
                        size_hint_y: None
                        height: self.minimum_height

        MDFloatingActionButton:
            icon: "plus"
            pos_hint: {"right": 0.94, "y": 0.03}
            on_release: root.open_new_entry()

<EntryEditScreen>:
    name: "entry_edit"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Редактирование записи" if root.is_editing else "Новая запись"
            left_action_items: [["arrow-left", lambda x: root.cancel()]]
            right_action_items: [["delete", lambda x: root.confirm_delete()]] if root.is_editing else []

        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16 * app.ui_scale)
                spacing: dp(12 * app.ui_scale)
                size_hint_y: None
                height: self.minimum_height

                MDTextField:
                    id: title_field
                    hint_text: "Название сервиса"
                    mode: "rectangle"
                    font_size: sp(15 * app.ui_scale)

                MDTextField:
                    id: username_field
                    hint_text: "Логин или email"
                    mode: "rectangle"
                    font_size: sp(15 * app.ui_scale)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(6 * app.ui_scale)
                    size_hint_y: None
                    height: dp(56 * app.ui_scale)

                    MDTextField:
                        id: secret_field
                        hint_text: "Пароль"
                        password: not root.show_password
                        mode: "rectangle"
                        font_size: sp(15 * app.ui_scale)

                    MDIconButton:
                        icon: "eye-off" if root.show_password else "eye"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.toggle_password_visibility()

                    MDIconButton:
                        icon: "autorenew"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.generate_new_password()

                MDTextField:
                    id: category_field
                    hint_text: "Категория (например, Почта, Банк)"
                    mode: "rectangle"
                    font_size: sp(15 * app.ui_scale)

                MDTextField:
                    id: note_field
                    hint_text: "Заметка"
                    mode: "rectangle"
                    font_size: sp(14 * app.ui_scale)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(8 * app.ui_scale)
                    size_hint_y: None
                    height: dp(40 * app.ui_scale)

                    MDIconButton:
                        icon: "star" if root.is_favorite else "star-outline"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.toggle_favorite()

                    MDLabel:
                        text: "В избранном"
                        font_size: sp(14 * app.ui_scale)
                        pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: root.status_text
                    theme_text_color: "Error"
                    font_style: "Caption"
                    font_size: sp(12 * app.ui_scale)
                    halign: "center"
                    adaptive_height: True

                MDRaisedButton:
                    text: "Сохранить"
                    font_size: sp(15 * app.ui_scale)
                    size_hint_x: 1
                    size_hint_y: None
                    height: dp(46 * app.ui_scale)
                    on_release: root.save_entry()